# Copiá este archivo a .env y ajustá lo que necesites. El docker-compose ya trae
# defaults de desarrollo, así que `docker compose up` funciona sin crear .env.
# REGLA DURA: no subir un .env real con secretos al repositorio.

# --- Base de datos ---
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=biblioteca

# --- Seguridad ---
# Secreto para firmar el JWT (mínimo 32 bytes). En prod usá uno fuerte y único.
JWT_SECRET=dev-only-insecure-secret-change-me-please-32bytes-min-abcdefgh

# --- URLs / correo ---
APP_FRONTEND_BASE_URL=http://localhost:4200

# --- Usuario ADMIN de arranque (seeder idempotente) ---
APP_ADMIN_EMAIL=admin@biblioteca.local
APP_ADMIN_PASSWORD=Admin123!

# --- Puertos del host (cambialos si ya tenes algo ocupando el default) ---
FRONTEND_PORT=4200
BACKEND_PORT=8080
POSTGRES_PORT=5433
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
